      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:ar|en)$/]",
        "message": "<StatusPill> lang must be one of 'ar' | 'en'."
