      {
        "selector": "JSXOpeningElement[name.name='VariantOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|swatch|soldOut|key|ref|className|style|children)$/]",
        "message": "<VariantOption> doesn't accept that prop. Declared props: value, label, swatch, soldOut."
      }
