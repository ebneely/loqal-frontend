      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute[name.name='lang'] > Literal[value!=/^(?:ar|en)$/]",
        "message": "<SearchField> lang must be one of 'ar' | 'en'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|note|disabled|group|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label, note, disabled, group."
      },
