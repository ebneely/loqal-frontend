# Where the NestJS API lives. Server-side reads go straight here; the browser
# never sees it — it talks to /api on this origin and the BFF proxy forwards.
#
# REQUIRED in production. Without it the app throws at startup rather than
# serving a storefront that reaches nothing and renders empty states.
LOQAL_API_ORIGIN=http://127.0.0.1:3001

# Absolute origin of the storefront itself. Used for metadataBase, canonical
# URLs, robots.txt and the sitemap — all of which must be absolute for a
# crawler to resolve them.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host serving brand-supplied product photography. next/image refuses a remote
# URL from any host not listed here, so with this unset every product photo
# falls back to its grey well.
LOQAL_MEDIA_HOST=
